{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Presidio": {
    "BaseUrl": "http://localhost:5001"
  },
  "ReverseProxy": {
    "Routes": {
      "ai-route": {
        "ClusterId": "ollama-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ollama-cluster": {
        "Destinations": {
          "ollama-instance": {
            "Address": "http://localhost:11434/"
          }
        }
      }
    },
    "LanguageDetection": {
      "SupportedLanguages": [ "da", "en", "de" ],
      "DefaultFallback": "en"
    }
  }
}