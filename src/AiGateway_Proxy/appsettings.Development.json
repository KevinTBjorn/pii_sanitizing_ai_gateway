{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AiGateway_Core": "Debug"
    }
  },
  "AllowedHosts": "*",
  "PiiOptions": {
    "presidioURL": "http://localhost:5001",
    "TimeoutSeconds": 13
  },
  "LanguageDetection": {
    "SupportedLanguages": [ "da", "en" ],
    "DefaultFallback": "en"
  },
  "ReverseProxy": {
    "Routes": {
      "ai-route": {
        "ClusterId": "ollama-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ollama-cluster": {
        "Destinations": {
          "ollama-instance": {
            "Address": "http://localhost:11434/"
          }
        }
      }
    }
  }
}