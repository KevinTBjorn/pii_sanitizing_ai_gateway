{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PiiOptions": {
    "presidioURL": "http://localhost:5001",
    "TimeoutSeconds": 13,
    "IgnoredKeys": [
      "model",
      "temperature",
      "top_p",
      "top_k",
      "max_tokens",
      "max_completion_tokens",
      "stream",
      "presence_penalty",
      "frequency_penalty",
      "repeat_penalty",
      "num_predict",
      "keep_alive",
      "seed",
      "stop",
      "response_format",
      "tools",
      "tool_choice",
      "functions",
      "role",
      "type",
      "id",
      "object",
      "created",
      "usage"
    ]
  },
  "LanguageDetection": {
    "SupportedLanguages": [ "da", "en" ],
    "DefaultFallback": "en"
  },
  "ReverseProxy": {
    "Routes": {
      "ai-route": {
        "ClusterId": "ollama-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ollama-cluster": {
        "Destinations": {
          "ollama-instance": {
            "Address": "http://localhost:11434/"
          }
        }
      }
    }
  }
}