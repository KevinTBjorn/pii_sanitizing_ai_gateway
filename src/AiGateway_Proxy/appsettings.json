{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AiGateway_Core": "Debug"
    }
  },
  "AllowedHosts": "*",
  "PresidioOptions": {
    "PresidioUrl": "http://localhost:5001/",
    "TimeoutSeconds": 13
  },
  "LanguageDetection": {
    "SupportedLanguages": [ "da", "en" ],
    "DefaultFallback": "en"
  },
  "LlmRoutingOptions": {
    "ModelRoutes": [
      {
        "Model": "smollm:135m",
        "Url": "http://localhost:11434/v1/chat/completions",
        "Format": "OpenAi"
      }
    ]
  }
}